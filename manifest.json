{
  "manifest_version": 3,
  "name": "AI对话复盘助手",
  "version": "1.0",
  "description": "自动记录 AI 对话，支持搜索、导出和复盘",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["https://chat.deepseek.com/*", "https://www.doubao.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*", "https://www.doubao.com/*"],
      "js": ["interceptor.js", "adapters/deepseek.js", "adapters/doubao.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://chat.deepseek.com/*", "https://www.doubao.com/*"],
      "js": ["relay.js"],
      "run_at": "document_start"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "打开对话复盘"
  }
}